  "cards": [
    {
      "id": "moonlit-01",
      "name": "留白",
      "number": 1,
      "assetURL": "/assets/oracle-art-v3-01-f6981b4c6ec3.jpg",
      "viewBox": [
        0,
        0,
        485.5,
        809.5
      ],
      "description": "牌面以一彎月亮為中心，外圈與兩側枝葉包住未被填滿的空間。這份空間是原創牌義的起點：暫停輸入，辨認自己的聲音。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-02",
      "name": "潮汐",
      "number": 2,
      "assetURL": "/assets/oracle-art-v3-01-f6981b4c6ec3.jpg",
      "viewBox": [
        485.5,
        0,
        485.5,
        809.5
      ],
      "description": "月下的三層波浪高低交錯，讓流動有了可見的節奏。這裡的水是情緒變化的比喻；觀察起伏，比要求每一刻都平靜更實際。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-03",
      "name": "根系",
      "number": 3,
      "assetURL": "/assets/oracle-art-v3-01-f6981b4c6ec3.jpg",
      "viewBox": [
        0,
        809.5,
        485.5,
        809.5
      ],
      "description": "枝葉向上展開，細根向下分岔，地面線把生長與支撐連在一起。根系的原創寓意是：看得見的進展，通常需要看不見的日常安排。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-04",
      "name": "門扉",
      "number": 4,
      "assetURL": "/assets/oracle-art-v3-01-f6981b4c6ec3.jpg",
      "viewBox": [
        485.5,
        809.5,
        485.5,
        809.5
      ],
      "description": "拱門裡有一道斜開的門片，門把與門前台階都清楚可見。門扉象徵可以試探的入口；跨出一步，與立刻承諾走完整條路，是不同的事。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-05",
      "name": "界線",
      "number": 5,
      "assetURL": "/assets/oracle-art-v3-02-3c026b4a3d02.jpg",
      "viewBox": [
        0,
        0,
        485.5,
        809.5
      ],
      "description": "兩層山脊有清楚的輪廓，也保留山谷的通道。原創解讀把這些邊緣當作範圍的比喻：能接近彼此，也能知道哪裡需要停下。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-06",
      "name": "微光",
      "number": 6,
      "assetURL": "/assets/oracle-art-v3-02-3c026b4a3d02.jpg",
      "viewBox": [
        485.5,
        0,
        485.5,
        809.5
      ],
      "description": "小燭焰被兩圈光暈包住，火光照出的是近處，並沒有照亮整張牌。微光的原創重點是找到眼前可用的支持，讓下一步有落腳處。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-07",
      "name": "回聲",
      "number": 7,
      "assetURL": "/assets/oracle-art-v3-02-3c026b4a3d02.jpg",
      "viewBox": [
        0,
        809.5,
        485.5,
        809.5
      ],
      "description": "一滴水位在層層橢圓漣漪上方，圓心與擴散方向都能被看見。回聲讓重複有了形狀：既觀察同一反應，也回到最初發生的事件。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-08",
      "name": "同行",
      "number": 8,
      "assetURL": "/assets/oracle-art-v3-02-3c026b4a3d02.jpg",
      "viewBox": [
        485.5,
        809.5,
        485.5,
        809.5
      ],
      "description": "兩株不同顏色的枝葉各有莖幹，向中間伸展，卻沒有合成同一株。這是原創牌義的關係比喻：可以相互靠近，也保有各自的立足點。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-09",
      "name": "新月",
      "number": 9,
      "assetURL": "/assets/oracle-art-v3-03-79609d356da1.jpg",
      "viewBox": [
        0,
        0,
        485.5,
        809.5
      ],
      "description": "暗色圓面與周圍光點，把尚未成形的部分留在中央。空白容納可能，也提醒你先辨認自己的意圖，再決定要投入什麼。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-10",
      "name": "星河",
      "number": 10,
      "assetURL": "/assets/oracle-art-v3-03-79609d356da1.jpg",
      "viewBox": [
        485.5,
        0,
        485.5,
        809.5
      ],
      "description": "燭火照亮近處，五顆相連的星點延伸出遠方的脈絡。局部線索與整體方向需要一起觀看，連結也需要實際證據。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-11",
      "name": "晨露",
      "number": 11,
      "assetURL": "/assets/oracle-art-v3-03-79609d356da1.jpg",
      "viewBox": [
        0,
        809.5,
        485.5,
        809.5
      ],
      "description": "青綠莖葉、伸展的根與三滴露水，把注意力落在細小而清楚的感受。滋養可以很輕，也需要靠近才能辨認。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-12",
      "name": "霧林",
      "number": 12,
      "assetURL": "/assets/oracle-art-v3-03-79609d356da1.jpg",
      "viewBox": [
        485.5,
        809.5,
        485.5,
        809.5
      ],
      "description": "莖葉與根仍然存在，三道半透明橫霧遮住部分視線。看不清楚不等於沒有依據，耐心也需要具體的觀察方式。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-13",
      "name": "落葉",
      "number": 13,
      "assetURL": "/assets/oracle-art-v3-04-098e637f7027.jpg",
      "viewBox": [
        0,
        0,
        485.5,
        809.5
      ],
      "description": "仍然站立的植物與根，旁邊有兩片落下的褐葉。放下一部分不會抹去曾經的投入，取捨能讓留下的事物得到照顧。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-14",
      "name": "萌芽",
      "number": 14,
      "assetURL": "/assets/oracle-art-v3-04-098e637f7027.jpg",
      "viewBox": [
        485.5,
        0,
        485.5,
        809.5
      ],
      "description": "地線上伸出一株帶著兩片葉的嫩芽。成長需要適合的條件與持續照顧，小小的進展也值得被看見。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-15",
      "name": "山徑",
      "number": 15,
      "assetURL": "/assets/oracle-art-v3-04-098e637f7027.jpg",
      "viewBox": [
        0,
        809.5,
        485.5,
        809.5
      ],
      "description": "層疊山峰旁有圓形天體，金色道路沿著地勢彎行。前進需要讀懂環境，調整步幅與休息也屬於路程的一部分。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-16",
      "name": "靜湖",
      "number": 16,
      "assetURL": "/assets/oracle-art-v3-04-098e637f7027.jpg",
      "viewBox": [
        485.5,
        809.5,
        485.5,
        809.5
      ],
      "description": "重疊水波與三道水平映光，呈現表面變化與清楚輪廓的共存。沉澱讓觀察更細緻，也讓不同層次的感受被辨認。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-17",
      "name": "晚風",
      "number": 17,
      "assetURL": "/assets/oracle-art-v3-05-65fab883c065.jpg",
      "viewBox": [
        0,
        0,
        485.5,
        809.5
      ],
      "description": "層層橢圓波紋圍著水滴展開，三道金色風線穿過畫面。水與風的流動，讓鬆開、調整與重新呼吸成為這張牌的核心。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-18",
      "name": "歸巢",
      "number": 18,
      "assetURL": "/assets/oracle-art-v3-05-65fab883c065.jpg",
      "viewBox": [
        485.5,
        0,
        485.5,
        809.5
      ],
      "description": "開敞的拱門與一側門板留下可進可出的界線，枝條和右上方的簡筆飛鳥，讓歸屬連結到停留、補給與再次出發。",
      "version": "hopeful-painted-v3"
    },
    {
      "id": "moonlit-19",
      "name": "休憩",
      "number": 19,
      "assetURL": "/assets/oracle-art-v3-05-65fab883c065.jpg",
